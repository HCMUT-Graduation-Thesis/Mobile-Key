<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="40dp">

    <!-- Central Progress Indicator (Clean & Minimal) -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/cp_pairing_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/primary_blue"
        app:indicatorSize="72dp"
        app:trackThickness="6dp"
        app:trackCornerRadius="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Ready to Pair"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Place your phone near the vehicle's NFC reader to securely exchange keys."
        android:textColor="@color/gray_text"
        android:textSize="14sp"
        android:lineSpacingExtra="4sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Hold steady..."
        android:textColor="@color/warning_orange"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:textAllCaps="true" />

</LinearLayout>
