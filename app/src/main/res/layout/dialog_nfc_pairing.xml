<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="40dp">

    <!-- Central Progress Indicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/cp_pairing_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/primary_blue"
        app:indicatorSize="80dp"
        app:trackThickness="8dp"
        app:trackCornerRadius="4dp" />

    <ImageView
        android:id="@+id/iv_pairing_success"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/checkbox_on_background"
        app:tint="@color/success_green"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_phase_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Ready to Pair"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_phase_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Place your phone near the vehicle's NFC reader to securely exchange keys."
        android:textColor="@color/gray_text"
        android:textSize="14sp"
        android:lineSpacingExtra="4sp" />

</LinearLayout>
