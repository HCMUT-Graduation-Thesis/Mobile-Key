<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true">

    <!-- Header (Standard Height) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_share_config"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/white"
        app:title="Share Configuration"
        app:titleTextColor="@color/white" />

    <!-- TabLayout (Below Header) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl_share_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/toolbar_share_config"
        app:tabIndicatorColor="@color/primary_blue"
        app:tabSelectedTextColor="@color/primary_blue"
        app:tabTextColor="@color/gray_text"
        app:tabMode="fixed">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permanent" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Timed" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="One-Time" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recurring" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Content Scrollable Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btn_send_ekey"
        app:layout_constraintTop_toBottomOf="@id/tl_share_type">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Common Fields (Below Tabs, Before Details) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Recipient (Phone / Email)"
                android:layout_marginBottom="12dp"
                app:hintTextColor="@color/primary_blue"
                app:boxStrokeColor="@color/primary_blue">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_share_recipient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Friendly Name"
                android:layout_marginBottom="24dp"
                app:hintTextColor="@color/primary_blue"
                app:boxStrokeColor="@color/primary_blue">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_share_friendly_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="24dp"/>

            <!-- Tab-Specific Content Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 1. Permanent -->
                <LinearLayout
                    android:id="@+id/container_permanent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Permanent Key: No expiration date. Unlimited access until revoked."
                        android:textColor="@color/gray_text" />
                </LinearLayout>

                <!-- 2. Timed -->
                <LinearLayout
                    android:id="@+id/container_timed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Start Date/Time"
                        android:layout_marginBottom="12dp"
                        app:hintTextColor="@color/primary_blue">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_timed_start"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:focusable="false"
                            android:clickable="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="End Date/Time"
                        app:hintTextColor="@color/primary_blue">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_timed_end"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:focusable="false"
                            android:clickable="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- 3. One-Time -->
                <LinearLayout
                    android:id="@+id/container_one_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Key expires after 1 use. Valid within the time window."
                        android:textColor="@color/gray_text"
                        android:layout_marginBottom="12dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Time Window (Slot X)"
                        app:hintTextColor="@color/primary_blue">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_onetime_window"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:focusable="false"
                            android:clickable="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- 4. Recurring -->
                <LinearLayout
                    android:id="@+id/container_recurring"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Validity Period"
                        android:textColor="@color/primary_blue"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:hint="From Date"
                            app:hintTextColor="@color/primary_blue">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_recurring_from"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:focusable="false"
                                android:clickable="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:hint="To Date"
                            app:hintTextColor="@color/primary_blue">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_recurring_to"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:focusable="false"
                                android:clickable="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Repeat Days"
                        android:textColor="@color/primary_blue"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"/>
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="4">
                        <CheckBox android:text="Mon" android:textColor="@color/white" app:buttonTint="@color/primary_blue" />
                        <CheckBox android:text="Tue" android:textColor="@color/white" app:buttonTint="@color/primary_blue" />
                        <CheckBox android:text="Wed" android:textColor="@color/white" app:buttonTint="@color/primary_blue" />
                        <CheckBox android:text="Thu" android:textColor="@color/white" app:buttonTint="@color/primary_blue" />
                        <CheckBox android:text="Fri" android:textColor="@color/white" app:buttonTint="@color/primary_blue" />
                        <CheckBox android:text="Sat" android:textColor="@color/white" app:buttonTint="@color/primary_blue" />
                        <CheckBox android:text="Sun" android:textColor="@color/white" app:buttonTint="@color/primary_blue" />
                    </GridLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Time Window (Daily)"
                        android:layout_marginTop="12dp"
                        app:hintTextColor="@color/primary_blue">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_recurring_window"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:focusable="false"
                            android:clickable="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Action Button (Safe from Navigation Bar) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_send_ekey"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        android:text="SEND"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_blue"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
