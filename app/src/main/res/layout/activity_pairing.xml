<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F0F2F5"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Owner Pairing"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/et_pairing_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Pairing Password"
        android:inputType="textPassword"
        android:text="12345678"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_start_pairing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Password &amp; Wait for NFC"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pairing Progress Log:"
            android:textStyle="bold"
            android:layout_centerVertical="true"/>

        <Button
            android:id="@+id/btn_clear_pairing_log"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:backgroundTint="#777777"
            android:text="Clear"
            android:textSize="10sp"
            android:paddingHorizontal="8dp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_pairing_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="#00FF00"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>
