<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_control"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/white"
            app:title="Key Control"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Upper Section (60%): Control Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6.5"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Vehicle Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/tv_detail_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VinFast VF8"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_detail_plate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="30H-123.45"
                        android:textColor="@color/gray_text"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/view_status_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_dot_green" />

                        <TextView
                            android:id="@+id/tv_connection_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Connected"
                            android:textColor="@color/success_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Control Grid 2x2 -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:columnCount="2"
                android:rowCount="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_control_unlock"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="UNLOCK"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/primary_blue"
                    app:icon="@android:drawable/ic_lock_idle_lock"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconSize="24dp"
                    app:cornerRadius="12dp"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_control_lock"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="LOCK"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/primary_blue"
                    app:icon="@android:drawable/ic_lock_lock"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconSize="24dp"
                    app:cornerRadius="12dp"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_control_start"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="STOP ENGINE"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/error_red"
                    app:icon="@android:drawable/ic_media_pause"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconSize="24dp"
                    app:cornerRadius="12dp"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_control_trunk"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="TRUNK"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/primary_blue"
                    app:icon="@android:drawable/btn_star"
                    app:iconGravity="top"
                    app:iconPadding="4dp"
                    app:iconSize="24dp"
                    app:cornerRadius="12dp"
                    android:textSize="12sp" />
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_advanced"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="ADVANCED"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_car_info"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="INFORMATION"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Lower Section (Quick Access Menu) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.5"
            app:cardBackgroundColor="#0A0A0A"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="-32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="24dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@color/divider"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ekeys"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical|start"
                    android:text="eKeys Manager"
                    android:textColor="@color/white"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconPadding="16dp"
                    app:iconTint="@color/primary_blue" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_records"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical|start"
                    android:text="Activity Records"
                    android:textColor="@color/white"
                    app:icon="@android:drawable/ic_menu_recent_history"
                    app:iconPadding="16dp"
                    app:iconTint="@color/primary_blue" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_settings"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical|start"
                    android:text="Vehicle Settings"
                    android:textColor="@color/white"
                    app:icon="@android:drawable/ic_menu_manage"
                    app:iconPadding="16dp"
                    app:iconTint="@color/primary_blue" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/primary_blue" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
